{
  "$schema": "https://raw.githubusercontent.com/Blockchains/.github/main/docs/blocks.schema.json",
  "schema_version": "1.0",
  "name": "forge-example-gasless-membership",
  "repo": "Blockchains/forge-example-gasless-membership",
  "summary": "Composed gasless membership club: ERC-721 pass with an approver allowlist (MembershipNFT) and an ERC-4337 paymaster that sponsors exactly the join() UserOperation (ClubPaymaster, extends eth-infinitism BasePaymaster v0.9.0), plus a viem front end.",
  "kind": [
    "contracts",
    "web-app"
  ],
  "stability": "reference",
  "license": "GPL-3.0-or-later",
  "homepage": "https://blockchains.github.io/forge-example-gasless-membership/",
  "entrypoints": [
    {
      "type": "solidity",
      "name": "MembershipNFT",
      "ref": "src/MembershipNFT.sol",
      "install": "forge install Blockchains/forge-example-gasless-membership"
    },
    {
      "type": "solidity",
      "name": "ClubPaymaster",
      "ref": "src/ClubPaymaster.sol",
      "install": "forge install Blockchains/forge-example-gasless-membership"
    },
    {
      "type": "file",
      "name": "script/Deploy.s.sol",
      "ref": "script/Deploy.s.sol",
      "usage": "forge script script/Deploy.s.sol --rpc-url $SEPOLIA_RPC_URL --account <keystore> --broadcast"
    },
    {
      "type": "file",
      "name": "component-map.json, plan.json",
      "ref": "component-map.json",
      "usage": "provenance: capability → component → pinned fork commit"
    },
    {
      "type": "web",
      "name": "web/",
      "ref": "web/",
      "usage": "cd web && npm ci && npm run dev"
    }
  ],
  "inputs": [
    {
      "name": "constructor args",
      "type": "Solidity",
      "description": "MembershipNFT(admin, baseURI); ClubPaymaster(IEntryPoint ep, MembershipNFT club, uint256 maxCost, address owner)"
    }
  ],
  "outputs": [
    {
      "name": "deployed contracts",
      "type": "EVM"
    },
    {
      "name": "events/errors",
      "type": "ABI",
      "description": "see src/"
    }
  ],
  "deps": [
    "foundry (solc 0.8.30)",
    "node>=20 (web/)"
  ],
  "compatible_with": [
    {
      "repo": "Blockchains/blockchainlab-index",
      "how": "the composer that generated this repo"
    },
    {
      "repo": "Blockchains/blockchainlab-index",
      "how": "components were retrieved from the index"
    },
    {
      "repo": "Blockchains/blockchainlab-starters",
      "how": "erc4337-smart-account starter"
    },
    {
      "repo": "Blockchains/blockchainlab-sdk",
      "how": "RPC health for the front end"
    }
  ],
  "tests": {
    "command": "forge test -vv",
    "ci": ".github/workflows/ci.yml",
    "network": true
  },
  "env": [
    {
      "name": "MAINNET_RPC_URL",
      "required": false,
      "purpose": "enables live-chain fork tests"
    },
    {
      "name": "SEPOLIA_RPC_URL",
      "required": false,
      "purpose": "deploy target"
    },
    {
      "name": "DEPLOYER_PRIVATE_KEY",
      "required": false,
      "purpose": "repo secret for the Deploy workflow only; never in files"
    }
  ],
  "docs": {
    "readme": "README.md",
    "agents": "AGENTS.md",
    "llms": "llms.txt"
  }
}
